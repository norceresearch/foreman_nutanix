<%= compute_specific_js(compute_resource, "host_edit") %>
<%= javascript "hosts", "host_edit", "host_edit_interfaces" %>

<%= text_f f,
:description,
label: _("Description"),
help_inline: _("Description for VM in Nutanix") %>

<%= select_f f,
:image_id,
compute_resource.available_images,
:id,
:name,
{ include_blank: _("Select Image") },
{
  label: _("Image"),
  help_inline: _("Operating system image to use (optional)"),
} %>

<%# NOTE: If we're on a Host Edit page - show the selected
#      network by not having a 'include_blank'. Once
#      editing is implemented, this might be able to go away. %>
<% include_blank =
  f.object.class == "ForemanNutanix::NutanixCompute" ? nil : _("Select Network") %>
<%= select_f f,
:network_id,
compute_resource.available_networks,
:id,
:name,
{ include_blank: include_blank, selected: f.object.try(:network_id) },
{ label: _("Network"), help_inline: _("Network/subnet for the VM") } %>

<%= select_f f,
:storage_container,
compute_resource.available_storage_containers,
:id,
:name,
{
  include_blank: _("Select Container"),
  selected: f.object.try(:storage_container),
},
{
  label: _("Storage Container"),
  help_inline: _("Storage container for VM disks"),
} %>

<%= counter_f f,
:cpus,
{ label: _("CPUs"), help_inline: _("Number of CPU cores"), min: 1, max: 32 } %>

<%= counter_f f,
:memory,
{
  label: _("Memory (GB)"),
  help_inline: _("Amount of memory in GB"),
  min: 1,
  max: 64,
} %>

<%= counter_f f,
:disk_size_gb,
{
  label: _("Disk Size (GB)"),
  help_inline: _("Size of the boot disk in GB"),
  min: 2,
  max: 10_000,
} %>

<%# One select for three shim fields: the option value is the composite
#    "<device_id>:<vendor_name>:<gpu_type>". NutanixCompute#save splits it.
#    Passthrough only - available_gpus filters vGPU profiles out. %>
<%= select_f f,
:gpu,
compute_resource.available_gpus,
:id,
:name,
{ include_blank: _("No GPU"), selected: f.object.try(:gpu) },
{
  label: _("GPU"),
  help_inline: _("Passthrough GPU to attach when the VM is created"),
  id: "gpu-select",
} %>

<div id="gpu-options" class="hidden">
  <%= counter_f f,
  :gpu_count,
  {
    label: _("GPU Count"),
    help_inline: _("How many of the selected GPU to attach"),
    min: 1,
    max: 8,
  } %>
</div>

<%# `checked:` must reflect the saved value, else the box always renders
#    checked and the compute profile's "off" never survives a page render.
#    f.object is compute_resource.new_vm(vm_attrs); NutanixCompute has no :start
#    attribute (its #start is the power-on action), so read the raw args. %>
<%# NOTE: no params fallback - every render path (profile edit, host form,
#    failed-create re-render) already builds f.object via new_vm() from the
#    authoritative attrs, and reading params here would win over a freshly
#    selected profile on the compute_profile_selected AJAX re-render. %>
<% start_checked = f.object.try(:args)&.dig(:start) %>
<%= checkbox_f f,
:start,
{
  label: _("Start After Creation"),
  help_inline:
    _(
      "Start the VM after Foreman completes all provisioning steps (DHCP, DNS, TFTP, etc.)",
    ),
  checked: start_checked.nil? || %w[1 true].include?(start_checked.to_s),
} %>

<%= select_f f,
:boot_method,
compute_resource.available_boot_methods,
:id,
:name,
{ include_blank: _("Select boot method") },
{
  label: _("Boot method"),
  help_inline: _("Select boot method"),
  id: "boot-method-select",
} %>

<div id="uefi-options" class="hidden">
  <%= checkbox_f f,
  :secure_boot,
  { label: _("Secure Boot"), help_inline: _("Enable secure boot") } %>
</div>

<script>
  var $bootMethod = $('#boot-method-select');
  var $gpu = $('#gpu-select');

  function toggleUefiOptions() {
    $('#uefi-options').toggleClass('hidden', $bootMethod.val() !== 'uefi');
  }

  // Same pattern as above: the count only means anything once a GPU is picked,
  // and the blank "No GPU" option posts an empty value.
  function toggleGpuOptions() {
    $('#gpu-options').toggleClass('hidden', !$gpu.val());
  }

  toggleUefiOptions();
  toggleGpuOptions();
  $bootMethod.on('change', toggleUefiOptions);
  $gpu.on('change', toggleGpuOptions);
</script>
